# Smart Capture Environment Configuration

# Public Web URL (e.g., https://smartcapture.app or http://localhost:3000)
VITE_APP_URL=http://localhost:3000

# Base path for deployment (e.g., ./ for portable or /smart-capture/ for GitHub Pages)
VITE_BASE_PATH=./

# Supabase Configuration (Optional - Smart Capture runs locally/offline via IndexedDB when empty)
# NEVER commit service_role key to Git or client-side code!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NHTSA vPIC Public API URL (Defaults to official public endpoint)
VITE_NHTSA_API_URL=https://vpic.nhtsa.dot.gov/api

# Integration Partner Endpoints (Optional)
VITE_DDRIVE_API_URL=https://api.ddriveauto.com
